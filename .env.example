# Copy to .env next to docker-compose.yml and adjust. Everything is optional.

# Time zone for timestamps, reports and schedules.
TZ=Europe/Berlin

# Reach the dashboard over Tailscale (HTTPS through `tailscale serve`, no port
# opened to the internet). Create a key at https://login.tailscale.com/admin/settings/keys
# Needs MagicDNS and HTTPS certificates enabled in your tailnet.
# TS_AUTHKEY=tskey-auth-...

# When Watchtower looks for a new image (seconds minutes hours day month weekday).
# WATCHTOWER_SCHEDULE=0 0 4 * * *
